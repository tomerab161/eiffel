{
  "name": "@app/api",
  "description": "Fastify HTTP API: modules of routes → service → repository, validated with domain Zod schemas, stored in MongoDB.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node --env-file-if-exists=../../.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@app/domain": "workspace:*",
    "fastify": "^5.12.7",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^7.0.0",
    "mongodb": "^7.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
