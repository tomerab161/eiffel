{
  "permissions": {
    "allow": [
      "Bash(node agent-kit/scripts/*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm e2e:*)",
      "Bash(pnpm exec vitest:*)",
      "Bash(pnpm exec biome:*)",
      "Bash(pnpm exec tsc:*)",
      "Bash(pnpm exec turbo run:*)",
      "Bash(pnpm exec depcruise:*)",
      "Bash(pnpm exec stryker run:*)",
      "Bash(pnpm exec playwright test:*)",
      "Bash(pnpm exec playwright show-report:*)",
      "Bash(pnpm exec eslint:*)",
      "Bash(pnpm exec secretlint:*)",
      "Bash(pnpm audit:*)",
      "Bash(pnpm list:*)",
      "Bash(pnpm why:*)",
      "Bash(pnpm outdated:*)",
      "Bash(pnpm update:*)",
      "Bash(pnpm install --frozen-lockfile:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git switch -c:*)",
      "Bash(ls:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push origin +*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset --hard:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr ready:*)",
      "Bash(glab mr merge:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "WebFetch",
      "WebSearch",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Edit(./agent-kit/**)",
      "Edit(./agent-kit.config.json)",
      "Edit(./.claude/**)",
      "Edit(./.agent-kit/mutation-baseline.json)",
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)",
      "Bash(pnpm dlx:*)",
      "Bash(pnpm exec playwright install:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(yarn:*)",
      "Edit(./.dependency-cruiser.cjs)",
      "Edit(./stryker.config.json)",
      "Edit(./biome.json)",
      "Edit(./eslint.security.config.mjs)",
      "Edit(./.secretlintrc.json)",
      "Edit(./vitest.config.ts)",
      "Edit(./**/vitest.config.ts)",
      "Edit(./**/playwright.config.ts)",
      "Edit(./tsconfig.base.json)",
      "Edit(./tsconfig.depcruise.json)",
      "Edit(./turbo.json)",
      "Edit(./pnpm-workspace.yaml)",
      "Edit(./.npmrc)",
      "Edit(./pnpm-lock.yaml)",
      "Edit(./.agent-kit/security-allowlist.json)",
      "Edit(./.github/**)",
      "Edit(./.gitlab-ci.yml)",
      "Edit(./.gitlab/**)",
      "Edit(./CODEOWNERS)",
      "Bash(git push --no-verify:*)",
      "Bash(git push --delete:*)",
      "Bash(git push -d:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(git config:*)",
      "Bash(git -c:*)",
      "Bash(gh pr create:*)",
      "Bash(glab mr create:*)",
      "Bash(gh issue:*)",
      "Bash(glab issue:*)",
      "Bash(gh api:*)",
      "Bash(glab api:*)",
      "Edit(./.git/**)",
      "Edit(./**/.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/write-dir-only.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-on-stop.mjs\""
          }
        ]
      }
    ]
  }
}
