{
  "name": "my-project",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome ci --error-on-warnings .",
    "format": "biome check --write .",
    "test": "vitest run",
    "verify": "node agent-kit/scripts/verify.mjs",
    "verify:fast": "node agent-kit/scripts/verify.mjs fast",
    "verify:quality": "node agent-kit/scripts/verify.mjs quality",
    "map": "node agent-kit/scripts/map.mjs",
    "classify": "node agent-kit/scripts/classify.mjs",
    "e2e": "playwright test --config apps/web/playwright.config.ts"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "^8.0.0",
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@vitest/coverage-v8": "^5.0.4",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.12.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-security": "^4.2.0",
    "fast-check": "^4.10.2",
    "secretlint": "^13.0.7",
    "turbo": "^2.11.8",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
